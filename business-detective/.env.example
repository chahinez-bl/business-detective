# ---- Copy to .env (never commit .env). Every value below is read by backend/app/config.py ----
APP_ENV=development                 # development | staging | production
SECRET_KEY=                         # REQUIRED in staging/production: 32+ random chars, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./data/businessdetective.sqlite
#DATABASE_URL=postgresql+psycopg://user:password@host:5432/businessdetective     # production
CORS_ORIGINS=                       # only needed if the web app is hosted on a DIFFERENT domain than the API, e.g. https://app.businessdetective.com
TOKEN_TTL_MINUTES=720
MAX_UPLOAD_MB=15
MAX_ROWS=300000
STORAGE_DIR=./storage               # uploaded files + PDF reports (private; use a persistent volume in production)
AUTO_CREATE_TABLES=false            # true only for quick local development; otherwise run `alembic upgrade head`
FRONTEND_DIST=                      # optional: path of the built frontend so ONE process serves site + API (the Dockerfile sets this)
LOGIN_MAX_FAILURES=8
DEFAULT_CURRENCY=DZD

# ---- Optional external AI rephrasing (OFF by default; only summarised analytical facts are ever sent, never raw rows) ----
AI_PROVIDER=rules                   # rules | openai_compatible
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ---- Frontend build-time variables (set in the frontend host, not here, when hosting separately) ----
# VITE_API_URL=https://api.businessdetective.com     (leave unset when the API serves the site on the same domain)
# VITE_CONTACT_EMAIL=contact@your-domain.com
